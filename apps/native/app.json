{
  "expo": {
    "name": "micro-learn",
    "slug": "micro-learn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/learn/icon.png",
    "scheme": "micro-learn",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.micro-learn"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/learn/icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.microlearn"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/learn/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/learn/icon.png",
          "imageWidth": 240,
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a book\u2019s ISBN to find its ideas.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
